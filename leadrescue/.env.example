# ---------- Backend (local server / Lambda) ----------
# demo = deterministic simulated analysis (no AWS). bedrock = live Amazon Bedrock (needs AWS credentials).
AI_PROVIDER=demo
# local = JSON file (demo). dynamodb = AWS tables (set by the SAM template in AWS).
STORE=local
LOCAL_DATA_FILE=backend/data/local/leadrescue-db.json
# Required only when AI_PROVIDER=bedrock. Verify the ID in the Bedrock console for your Region first.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_TOOL_CHOICE=auto
BEDROCK_MAX_TOKENS=1500
STAFF_GROUP=staff
# Optional JSON list: [{"id":"maya","name":"Maya Chen","role":"Customer care lead"}]
STAFF_DIRECTORY=
# Local server only
DEMO_SESSION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AWS credentials come from your AWS profile or environment (never commit them here).
